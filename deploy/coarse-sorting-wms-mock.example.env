# 仅供联调。每条线独立选择模式，使用现场确认的架位、箱格和回调来源。
COARSE_SORTING_TAIL_ENABLED=true
# 固定模式使用现场盘的完整条码。
COARSE_SORTING_WMS_MOCK='{"round_id":"coarse-demo-01","ecs_source_ips":["192.0.2.10"],"normal_barcode":"TEST-NORMAL-01","additional_normal_barcodes":["TEST-NORMAL-02"],"ng_barcode":"TEST-NG-01","rack_position":"DEMO-POINT","allocation":{"result":"ALLOCATED","workline_code":"COARSE-DEMO","rack_id":"DEMO-RACK","bin_code":"DEMO-BIN","bin_location":"A","cell_id":"DEMO-CELL-01","cell_index":1,"bin_type":"3","reel_totalthickness":0}}'
# 随机模式逐格填写现场确认的空格。叠放上限 max_stack_height_mm 按实测毫米填写，120 仅作示例。
# COARSE_SORTING_WMS_MOCK='{"round_id":"coarse-demo-02","ecs_source_ips":["192.0.2.10"],"rack_position":"DEMO-POINT","empty_cells":[{"result":"ALLOCATED","workline_code":"COARSE-DEMO","rack_id":"DEMO-RACK","bin_code":"DEMO-BIN","bin_location":"A","cell_id":"DEMO-CELL-01","cell_index":1,"bin_type":"3","reel_totalthickness":0,"max_stack_height_mm":120}]}'
# RS01 和 RS02 同时启用时，用 JSON 数组包含两个完整轮次对象。下例中的实物编码和来源 IP 需按现场填写。
# COARSE_SORTING_WMS_MOCK='[{"round_id":"rs01-demo","ecs_source_ips":["192.0.2.10"],"rack_position":"CLN01","empty_cells":[{"result":"ALLOCATED","workline_code":"RS01","rack_id":"DEMO-RACK-01","bin_code":"DEMO-BIN-01","bin_location":"A","cell_id":"DEMO-CELL-01","cell_index":1,"bin_type":"3","reel_totalthickness":0,"max_stack_height_mm":120}]},{"round_id":"rs02-demo","ecs_source_ips":["192.0.2.11"],"rack_position":"CLN02","empty_cells":[{"result":"ALLOCATED","workline_code":"RS02","rack_id":"DEMO-RACK-02","bin_code":"DEMO-BIN-02","bin_location":"A","cell_id":"DEMO-CELL-02","cell_index":1,"bin_type":"3","reel_totalthickness":0,"max_stack_height_mm":120}]}]'

