ENVIRONMENT=local   # 生产/交付环境必须删掉或改成 production,否则开放 API 文档且 Cookie 不带 Secure
# 应用连接固定使用 enterprise_backend schema；不要修改共享数据库的全局 search_path。
DATABASE_URL=postgresql+asyncpg://admin:admin123@localhost:25432/enterprise_backend
REDIS_URL=redis://localhost:26379/0

# 生成方法: openssl rand -hex 32
JWT_SECRET_KEY=secret-string  # 非 local 环境至少 32 字符,否则启动失败
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 前端源,逗号分隔;同域部署(nginx 反代)留空
CORS_ORIGINS=http://localhost:5173

# 出站可靠交互：空目标仍扫描数据库，不创建 HTTP 客户端；已注册 wms-transport 协议适配器(见 app/main.py)，
# 配置对应目标后才会真正发送。
RELIABLE_TARGETS={}
RELIABLE_MAX_BODY_BYTES=262144
RELIABLE_DEFAULT_TIMEOUT_MS=10000
RELIABLE_MAX_RETRY_AFTER_S=3600
RELIABLE_RETENTION_DAYS=90
CALLBACK_SNAPSHOT_RETENTION_DAYS=7
TRANSPORT_STUCK_ALERT_MINUTES=120
RELIABLE_MAX_CONCURRENCY=4
RELIABLE_CLAIM_BATCH_SIZE=4
RELIABLE_DB_POOL_SIZE=2
# WMS Transport(协议 wms-transport，同一协议只配一个目标)；max_not_received_attempts 为合同要求的「确认未送达最多 3 次」，
# 不写则不设上限。启用前须验对端去重、安全和出口限流：
# RELIABLE_TARGETS={"targets":{"wms-transport":{"base_url":"http://10.24.199.217:8284","protocol":"wms-transport","max_not_received_attempts":3}}}
# 其它协议仅格式示例，启用前须由业务域注册协议适配器并验对端去重、安全和出口限流：
# RELIABLE_TARGETS={"defaults":{"retry_cap_s":300},"targets":{"peer":{"base_url":"https://example.test","protocol":"my-protocol","max_retry_after_s":1200}}}

# 以下仅容器部署(docker compose --profile app)使用,详见 docs/deploy.md
# 生产务必改密码(用 openssl rand -hex 16,避免特殊字符);已初始化过的数据卷改它不会改库里的密码
# POSTGRES_PASSWORD=admin123
# AUDIT_RETENTION_DAYS=90
# NGINX_PORT=80
# FRONTEND_DIST=./frontend-dist
# SITE_NGINX_CONFIG=/srv/enterprise-backend/shared/nginx/default.conf

# ECS P1: SNAPSHOT targets additionally require explicit route/annex/lifecycle/client assembly.
# No real ECS destination or device annex is enabled by this template.
