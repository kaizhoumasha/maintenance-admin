ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://admin:admin123@localhost:25432/maintenance
REDIS_URL=redis://localhost:26379/0

# 生成方法: openssl rand -hex 32
JWT_SECRET_KEY=secret-string  # 非 local 环境至少 32 字符,否则启动失败
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 前端源,逗号分隔;同域部署(nginx 反代)留空
CORS_ORIGINS=http://localhost:5173
